# NRC-OS External API Keys
# ========================
# SECURITY: Never commit actual keys to source control
# Copy this file to .env.local and fill in your keys

# NASA FIRMS - Fire Information for Resource Management System
# Get your key at: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

# GDACS - Global Disaster Alert and Coordination System
# Public API - no key required for basic access

# OpenWeather API (optional - for weather data)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# OpenRouter - Real-Time Incident Discovery Engine
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Environment identifier
NODE_ENV=development
